{
  "pythonVersion": "3.12",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "include": ["astrbot", "services", "tools", "maintenance", "data/plugins", "tests", "quality/tests", "main.py", "xiaoxia.py", "runtime_bootstrap.py"],
  "exclude": ["**/node_modules", "**/__pycache__", ".venvs", ".runtime"],
  "executionEnvironments": [
    {"root": "tests/cognition_state", "pythonVersion": "3.12", "extraPaths": [".", "data/plugins"]},
    {"root": "tests/registration", "pythonVersion": "3.12", "extraPaths": [".", "data/plugins"]},
    {"root": "services/memory", "pythonVersion": "3.12", "extraPaths": ["."]},
    {"root": "services/voice", "pythonVersion": "3.11", "extraPaths": [".", "vendor/soulx_singer"]},
    {"root": "services", "pythonVersion": "3.11", "extraPaths": ["."]},
    {"root": "tests/media_pipeline", "pythonVersion": "3.11", "extraPaths": [".", "vendor/soulx_singer"]},
    {"root": "maintenance/tests", "pythonVersion": "3.12", "extraPaths": [".", "data/plugins"]},
    {"root": ".", "pythonVersion": "3.12"}
  ]
}
